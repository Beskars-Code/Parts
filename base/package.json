{
    "name":  "parts-project",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "packageManager":  "bun@1.4.2",
    "scripts":  {
                    "dev":  "bun --bun run vite --port 3000 --strictPort",
                    "dev:all":  "bun scripts/development/dev-all.mjs",
                    "build":  "bun --bun run vite build",
                    "preview":  "bun --bun run vite preview",
                    "dev:convex":  "bun --bun run convex dev",
                    "dev:confect":  "bun x --bun --no-install --package @confect/cli confect dev",
                    "lint":  "bun tooling/lint/run.mjs",
                    "lint:structure":  "bun tooling/lint/structure/check.mjs",
                    "lint:i18n":  "bun tooling/i18n/check.mjs",
                    "lint:eslint":  "bun tooling/lint/eslint.mjs --max-warnings 0",
                    "lint:oxlint":  "bun run oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity error",
                    "lint:effect":  "bun --bun run effect-language-service diagnostics --project tsconfig.json --strict",
                    "lint:fix":  "bun tooling/lint/run.mjs --fix",
                    "typecheck":  "bun --bun run tsc --noEmit",
                    "knip":  "bun ./node_modules/knip/bin/knip.js --config knip.json",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "check":  "bun run lint \u0026\u0026 bun run typecheck \u0026\u0026 bun run knip",
                    "agent:login":  "bun scripts/development/agent-login.mjs",
                    "codegen:confect":  "bun x --bun --no-install --package @confect/cli confect codegen",
                    "lint:confect":  "bun tooling/lint/run.mjs --confect",
                    "codegen:auth":  "bun scripts/development/generate-auth-schema.mjs"
                },
    "dependencies":  {
                         "next-themes":  "0.4.6",
                         "use-intl":  "4.14.1",
                         "react":  "19.3.0",
                         "react-dom":  "19.3.0",
                         "convex":  "1.46.0",
                         "@tanstack/react-start":  "1.168.61",
                         "@tanstack/react-router":  "1.170.42",
                         "@confect/core":  "10.0.0",
                         "@confect/react":  "10.0.0",
                         "@confect/server":  "10.0.0",
                         "@convex-dev/better-auth":  "0.12.5",
                         "better-auth":  "1.6.33",
                         "effect":  "4.0.2"
                     },
    "devDependencies":  {
                            "@convex-dev/eslint-plugin":  "5.0.0",
                            "@effect/language-service":  "0.87.4",
                            "@eslint/js":  "9.39.5",
                            "@types/node":  "26.6.4",
                            "@types/react":  "19.3.0",
                            "@types/react-dom":  "19.3.0",
                            "eslint":  "9.39.5",
                            "eslint-plugin-jsx-a11y":  "6.10.2",
                            "eslint-plugin-unicorn":  "77.0.0",
                            "knip":  "6.40.0",
                            "oxlint":  "1.87.0",
                            "oxlint-tsgolint":  "7.0.2003",
                            "tailwindcss":  "4.3.3",
                            "typescript":  "6.0.3",
                            "typescript-eslint":  "8.71.1",
                            "@vitejs/plugin-react":  "6.1.2",
                            "@tailwindcss/vite":  "4.3.3",
                            "vite":  "8.3.4",
                            "vitest":  "5.0.3",
                            "eslint-plugin-import":  "2.32.0",
                            "eslint-plugin-react":  "7.37.5",
                            "eslint-plugin-react-hooks":  "7.1.1",
                            "eslint-import-resolver-typescript":  "4.4.5",
                            "globals":  "17.13.0",
                            "@confect/cli":  "10.0.0"
                        },
    "overrides": { "convex-helpers": "0.1.128" },
    "patchedDependencies":  {
                                "convex@1.46.0":  "patches/convex@1.46.0.patch",
                                "@effect/language-service@0.87.4":  "patches/@effect__language-service@0.87.4.patch",
                                "@confect/core@10.0.0":  "patches/@confect__core@10.0.0.patch",
                                "convex-helpers@0.1.128":  "patches/convex-helpers@0.1.128.patch",
                                "@convex-dev/better-auth@0.12.5":  "patches/@convex-dev%2Fbetter-auth@0.12.5.patch"
                            }
}
