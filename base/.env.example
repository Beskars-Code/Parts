# Cloud dev selects its configured backend and fetches app variables into .env.local.
# Convex writes destination connection metadata. Anonymous startup replaces these
# endpoints with its own HTTP loopback endpoints and restores the original file.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Required app variables: configure them on selected Convex for dev:cloud/build.
# dev:anonymous instead requires them in .env.local as its own backend seed.
SITE_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Optional guarded agent login, enabled only by explicit app seeds/settings:
# ENV=dev
# CLOUD_AGENT_AUTH_SECRET=
# Public app keys begin NEXT_, PUBLIC_, or VITE_; all other app keys stay server-side.
# Deployment/provider credentials and connection controls are never app seeds.
