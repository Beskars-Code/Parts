# Frontend public endpoint. Convex writes the destination deployment URL.
VITE_CONVEX_URL=
# Convex HTTP actions endpoint (cloud .site URL or local site port).
VITE_CONVEX_SITE_URL=

# Configure these on the Convex backend, not in the browser environment:
# SITE_URL, BETTER_AUTH_SECRET
# Optional guarded development agent: ENV=dev, CLOUD_AGENT_AUTH_SECRET
# Private agent process: CLOUD_AGENT_AUTH_SECRET (and cloud dev CONVEX_DEPLOY_KEY)
