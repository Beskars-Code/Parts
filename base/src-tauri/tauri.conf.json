{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Parts starter",
	"version": "0.1.0",
	"identifier": "com.parts.starter",
	"build": {
		"devUrl": "http://localhost:3000",
		"frontendDist": "https://configure-site.invalid"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"label": "main",
				"title": "Parts starter",
				"width": 1120,
				"height": 800,
				"minWidth": 360,
				"minHeight": 480
			}
		],
		"security": {
			"capabilities": ["main"]
		}
	},
	"bundle": {
		"active": false,
		"icon": ["icons/icon.png", "icons/icon.ico"]
	}
}
